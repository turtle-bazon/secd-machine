{
    "chip": "nrf52840",
    "description": "Nordic Semiconductor nRF52840 ARM Cortex-M4F (64MHz, 1MB flash, 256KB RAM, BLE 5.0, 802.15.4, NFC)",
    "output": {
        "format": "uf2",
        "family": "nrf52840"
    },
    "memory": {
        "flash_size": 1048576,
        "sram_size": 262144
    },
    "constraints": {
        "max_fixnum": 2047,
        "min_fixnum": -2048,
        "bignum_support": false,
        "max_string_length": 256,
        "max_list_depth": 64
    },
    "capabilities": [
        "gpio",
        "uart",
        "i2c",
        "spi",
        "adc",
        "pwm",
        "timer",
        "ble",
        "usb"
    ],
    "primitives": {
        "%gpio-init": {
            "id": 15,
            "args": 2
        },
        "%gpio-write": {
            "id": 16,
            "args": 2
        },
        "%gpio-read": {
            "id": 17,
            "args": 1
        },
        "%uart-init": {
            "id": 18,
            "args": 1
        },
        "%uart-write": {
            "id": 19,
            "args": 1
        },
        "%uart-read": {
            "id": 20,
            "args": 0
        },
        "%sleep": {
            "id": 21,
            "args": 1
        },
        "%millis": {
            "id": 22,
            "args": 0
        },
        "%adc-read": {
            "id": 23,
            "args": 1
        },
        "%pwm-write": {
            "id": 24,
            "args": 2
        },
        "%wave-play": {
            "id": 25,
            "args": 2
        },
        "%i2c-init": {
            "id": 26,
            "args": 3
        },
        "%i2c-write": {
            "id": 27,
            "args": 3
        },
        "%i2c-read": {
            "id": 28,
            "args": 3
        },
        "%i2c-write-read": {
            "id": 29,
            "args": 4
        },
        "%i2c-write-v": {
            "id": 30,
            "args": 3
        },
        "%radio-init": {
            "id": 31,
            "args": 2
        },
        "%radio-send": {
            "id": 32,
            "args": 1
        },
        "%radio-address": {
            "id": 33,
            "args": 1
        },
        "%ble-init": {
            "id": 34,
            "args": 0
        },
        "%ble-name": {
            "id": 35,
            "args": 1
        },
        "%ble-key": {
            "id": 36,
            "args": 2
        },
        "%ble-mouse": {
            "id": 37,
            "args": 3
        },
        "%radio-recv": {
            "id": 38,
            "args": 0
        },
        "%radio-set-channel": {
            "id": 39,
            "args": 1
        }
    },
    "usb": {
        "device": true,
        "controller": "nrf-usbd",
        "cdc": {
            "max_ports": 1,
            "device": true
        },
        "hid": {
            "device": true
        },
        "note": "nRF52840 native USB device controller supports CDC-ACM and HID classes via Nordic USB stack or CherryUSB."
    },
    "boards": [
        "nrf52840-promicro",
        "xiao-nrf52840-ble"
    ]
}