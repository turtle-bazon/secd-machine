{
    "chip": "atmega328p",
    "description": "Microchip ATmega328P 8-bit AVR microcontroller",
    "output": {
        "format": "bin"
    },
    "memory": {
        "flash_size": 32768,
        "sram_size": 2048
    },
    "constraints": {
        "max_fixnum": 2047,
        "min_fixnum": -2048,
        "bignum_support": false,
        "max_string_length": 64,
        "max_list_depth": 16
    },
    "capabilities": [
        "gpio",
        "uart",
        "spi",
        "i2c",
        "adc",
        "pwm",
        "timer"
    ],
    "usb": {
        "device": false,
        "note": "No USB peripheral on this chip; serial I/O is via UART only. USB primitives (%hid-*, %usb-*) will not compile."
    }
}