{
    "chip": "rp2350",
    "description": "RP2350 dual-core ARM Cortex-M33 / RISC-V (Hazard3) microcontroller",
    "output": {
        "format": "uf2",
        "family": "rp2350-arm-ns"
    },
    "memory": {
        "flash_size": 16777216,
        "sram_size": 532480
    },
    "constraints": {
        "max_fixnum": 2047,
        "min_fixnum": -2048,
        "bignum_support": false,
        "max_string_length": 256,
        "max_list_depth": 64
    },
    "capabilities": [
        "gpio",
        "uart",
        "spi",
        "i2c",
        "adc",
        "pwm",
        "timer"
    ],
    "primitives": {
        "%gpio-init": {
            "id": 15,
            "args": 2
        },
        "%gpio-write": {
            "id": 16,
            "args": 2
        },
        "%gpio-read": {
            "id": 17,
            "args": 1
        },
        "%uart-init": {
            "id": 18,
            "args": 1
        },
        "%uart-write": {
            "id": 19,
            "args": 1
        },
        "%uart-read": {
            "id": 20,
            "args": 0
        },
        "%sleep": {
            "id": 21,
            "args": 1
        },
        "%millis": {
            "id": 22,
            "args": 0
        },
        "%adc-read": {
            "id": 23,
            "args": 1
        },
        "%pwm-write": {
            "id": 24,
            "args": 2
        },
        "%wave-play": {
            "id": 25,
            "args": 2
        },
        "%i2c-init": {
            "id": 26,
            "args": 3
        },
        "%i2c-write": {
            "id": 27,
            "args": 3
        },
        "%i2c-read": {
            "id": 28,
            "args": 3
        },
        "%i2c-write-read": {
            "id": 29,
            "args": 4
        },
        "%hid-key": {
            "id": 30,
            "args": 2
        },
        "%usb-init": {
            "id": 31,
            "args": 0
        },
        "%usb-start": {
            "id": 32,
            "args": 0
        },
        "%usb-serial-add": {
            "id": 33,
            "args": 0
        },
        "%usb-hid-add": {
            "id": 34,
            "args": 0
        },
        "%serial-write": {
            "id": 35,
            "args": 2
        },
        "%serial-read": {
            "id": 36,
            "args": 1
        },
        "%serial-avail": {
            "id": 37,
            "args": 1
        },
        "%bn-add": {
            "id": 38,
            "args": 2
        },
        "%bn-sub": {
            "id": 39,
            "args": 2
        },
        "%bn-mul": {
            "id": 40,
            "args": 2
        },
        "%bn-div": {
            "id": 41,
            "args": 2
        },
        "%bn-mod": {
            "id": 42,
            "args": 2
        },
        "%bn-cmp": {
            "id": 43,
            "args": 2
        },
        "%bn-to-string": {
            "id": 44,
            "args": 1
        },
        "%bn-from-string": {
            "id": 45,
            "args": 1
        },
        "%radio-init": {
            "id": 46,
            "args": 2
        },
        "%radio-send": {
            "id": 47,
            "args": 1
        },
        "%radio-address": {
            "id": 48,
            "args": 1
        },
        "%ble-init": {
            "id": 49,
            "args": 0
        },
        "%ble-name": {
            "id": 50,
            "args": 1
        },
        "%ble-key": {
            "id": 51,
            "args": 2
        },
        "%ble-mouse": {
            "id": 52,
            "args": 3
        }
    },
    "usb": {
        "device": true,
        "controller": "otg",
        "cdc": {
            "max_ports": 6,
            "device": true
        },
        "serial": {
            "max_ports": 5,
            "device": true
        },
        "hid": {
            "device": true
        },
        "note": "RP2350 builds the same USB composite as RP2040 (CDC console + HID keyboard); the interface set is chosen by Lisp before %usb-start."
    }
}