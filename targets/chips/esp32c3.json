{
    "chip": "esp32c3",
    "description": "Espressif ESP32-C3 single-core RISC-V (RV32IMC) microcontroller",
    "output": {
        "format": "uf2",
        "family": "esp32c3"
    },
    "memory": {
        "flash_size": 4194304,
        "sram_size": 409600
    },
    "constraints": {
        "max_fixnum": 2147483647,
        "min_fixnum": -2147483648,
        "bignum_support": true,
        "max_string_length": 1024,
        "max_list_depth": 128
    },
    "capabilities": [
        "gpio",
        "uart",
        "spi",
        "i2c",
        "adc",
        "pwm",
        "wifi",
        "timer"
    ],
    "primitives": {
        "%gpio-init": {"id": 15, "args": 2},
        "%gpio-write": {"id": 16, "args": 2},
        "%gpio-read": {"id": 17, "args": 1},
        "%uart-init": {"id": 18, "args": 1},
        "%uart-write": {"id": 19, "args": 1},
        "%uart-read": {"id": 20, "args": 0},
        "%sleep": {"id": 21, "args": 1},
        "%millis": {"id": 22, "args": 0},
        "%adc-read": {"id": 23, "args": 1},
        "%pwm-write": {"id": 24, "args": 2},
        "%wave-play": {"id": 25, "args": 2},
        "%i2c-init": {"id": 26, "args": 3},
        "%i2c-write": {"id": 27, "args": 2},
        "%i2c-read": {"id": 28, "args": 2},
        "%i2c-write-read": {"id": 29, "args": 3}
    },
    "usb": {
        "device": true,
        "controller": "serial-jtag",
        "cdc": { "max_ports": 1, "device": true },
        "hid": { "device": false },
        "note": "ESP32-C3 USB is a fixed-function Serial/JTAG controller: one CDC serial port, no HID. HID primitives (%hid-*) will not compile."
    }
}