{
    "chip": "stm32f103",
    "description": "ST STM32F1 medium-density ARM Cortex-M3 microcontroller (72MHz, 128KB flash, 20KB SRAM)",
    "output": {
        "format": "bin",
        "family": "stm32f103"
    },
    "memory": {
        "flash_size": 131072,
        "sram_size": 20480
    },
    "constraints": {
        "max_fixnum": 2047,
        "min_fixnum": -2048,
        "bignum_support": false,
        "max_string_length": 256,
        "max_list_depth": 64
    },
    "capabilities": [
        "gpio",
        "uart",
        "i2c",
        "adc",
        "timer"
    ],
    "primitives": {
        "%gpio-init": {"id": 15, "args": 2},
        "%gpio-write": {"id": 16, "args": 2},
        "%gpio-read": {"id": 17, "args": 1},
        "%uart-init": {"id": 18, "args": 1},
        "%uart-write": {"id": 19, "args": 1},
        "%uart-read": {"id": 20, "args": 0},
        "%sleep": {"id": 21, "args": 1},
        "%millis": {"id": 22, "args": 0},
        "%adc-read": {"id": 23, "args": 1},
        "%i2c-init": {"id": 26, "args": 3},
        "%i2c-write": {"id": 27, "args": 3},
        "%i2c-read": {"id": 28, "args": 3},
        "%i2c-write-read": {"id": 29, "args": 4},
        "%i2c-write-v": {"id": 30, "args": 3}
    },
    "usb": {
        "device": false,
        "controller": "usb-fs-device",
        "note": "The F1 USB FS device peripheral exists but HID is not wired up in this build yet; USB primitives (%hid-*, %usb-*) will not compile."
    }
}
