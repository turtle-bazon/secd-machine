{
    "chip": "esp32s2",
    "description": "Espressif ESP32-S2 single-core Xtensa LX7 microcontroller (240MHz, Wi-Fi only, no Bluetooth)",
    "output": {
        "format": "bin",
        "family": "esp32s2"
    },
    "memory": {
        "flash_size": 4194304,
        "sram_size": 327680
    },
    "constraints": {
        "max_fixnum": 2147483647,
        "min_fixnum": -2147483648,
        "bignum_support": true,
        "max_string_length": 1024,
        "max_list_depth": 128
    },
    "capabilities": [
        "gpio",
        "uart",
        "spi",
        "i2c",
        "adc",
        "pwm",
        "wifi",
        "timer"
    ],
    "primitives": {
        "%gpio-init": {"id": 15, "args": 2},
        "%gpio-write": {"id": 16, "args": 2},
        "%gpio-read": {"id": 17, "args": 1},
        "%uart-init": {"id": 18, "args": 1},
        "%uart-write": {"id": 19, "args": 1},
        "%uart-read": {"id": 20, "args": 0},
        "%sleep": {"id": 21, "args": 1},
        "%millis": {"id": 22, "args": 0},
        "%adc-read": {"id": 23, "args": 1},
        "%pwm-write": {"id": 24, "args": 2},
        "%wave-play": {"id": 25, "args": 2},
        "%i2c-init": {"id": 26, "args": 3},
        "%i2c-write": {"id": 27, "args": 3},
        "%i2c-read": {"id": 28, "args": 3},
        "%i2c-write-read": {"id": 29, "args": 4},
        "%i2c-write-v": {"id": 30, "args": 3}
    },
    "usb": {
        "device": false,
        "controller": "otg-fs",
        "note": "The S2 has a native USB OTG FS core (a good future CherryUSB/HID target), but HID is not wired up in this build yet; USB primitives (%hid-*, %usb-*) will not compile."
    }
}
