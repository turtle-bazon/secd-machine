{
    "chip": "samd21",
    "description": "Microchip SAMD21 ARM Cortex-M0+ microcontroller (48MHz, 256KB flash, 32KB SRAM)",
    "output": {
        "format": "uf2",
        "family": "samd21"
    },
    "memory": {
        "flash_size": 262144,
        "sram_size": 32768
    },
    "constraints": {
        "max_fixnum": 2047,
        "min_fixnum": -2048,
        "bignum_support": false,
        "max_string_length": 256,
        "max_list_depth": 64
    },
    "capabilities": [
        "gpio",
        "uart",
        "spi",
        "i2c",
        "adc",
        "pwm",
        "timer"
    ],
    "primitives": {
        "%gpio-init": {
            "id": 15,
            "args": 2
        },
        "%gpio-write": {
            "id": 16,
            "args": 2
        },
        "%gpio-read": {
            "id": 17,
            "args": 1
        },
        "%sleep": {
            "id": 18,
            "args": 1
        },
        "%millis": {
            "id": 19,
            "args": 0
        },
        "%adc-read": {
            "id": 20,
            "args": 1
        },
        "%pwm-write": {
            "id": 21,
            "args": 2
        },
        "%wave-play": {
            "id": 22,
            "args": 2
        },
        "%bn-add": {
            "id": 23,
            "args": 2
        },
        "%bn-sub": {
            "id": 24,
            "args": 2
        },
        "%bn-mul": {
            "id": 25,
            "args": 2
        },
        "%bn-div": {
            "id": 26,
            "args": 2
        },
        "%bn-mod": {
            "id": 27,
            "args": 2
        },
        "%bn-cmp": {
            "id": 28,
            "args": 2
        },
        "%bn-to-string": {
            "id": 29,
            "args": 1
        },
        "%bn-from-string": {
            "id": 30,
            "args": 1
        }
    },
    "usb": {
        "device": false,
        "note": "No USB peripheral on this chip; serial I/O is via UART only. USB primitives (%hid-*, %usb-*) will not compile."
    }
}