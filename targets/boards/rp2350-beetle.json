{
    "name": "rp2350-beetle",
    "chip": "rp2350",
    "board": "DFRobot Beetle RP2350",
    "description": "DFRobot Beetle RP2350 (DFR1188, RP2350A QFN60), LED on IO25, user button on QSPI_SS, battery ADC IO29 (2MB flash)",
    "memory": {
        "flash_size": 2097152,
        "heap_size": 4095,
        "stack_size": 16000,
        "symbols_size": 256
    },
    "flash_layout": {
        "firmware_addr": 0,
        "firmware_size": 1048576,
        "bytecode_addr": 1048576,
        "bytecode_size": 524288
    },
    "board_pins": {
        "ws2812_pin": null,
        "led_pin": 25
    },
    "features": [
        "gpio",
        "uart",
        "sleep",
        "millis"
    ],
    "primitives": {
        "%gpio-init": {"id": 15, "args": 2},
        "%gpio-write": {"id": 16, "args": 2},
        "%gpio-read": {"id": 17, "args": 1},
        "%uart-init": {"id": 18, "args": 1},
        "%uart-write": {"id": 19, "args": 1},
        "%uart-read": {"id": 20, "args": 0},
        "%sleep": {"id": 21, "args": 1},
        "%millis": {"id": 22, "args": 0},
        "%adc-read": {"id": 23, "args": 1},
        "%pwm-write": {"id": 24, "args": 2},
        "%wave-play": {"id": 25, "args": 2},
        "%hid-key": {"id": 26, "args": 2},
        "%usb-init": {"id": 27, "args": 0},
        "%usb-start": {"id": 28, "args": 0},
        "%usb-serial-add": {"id": 29, "args": 0},
        "%usb-hid-add": {"id": 30, "args": 0},
        "%serial-write": {"id": 31, "args": 2},
        "%serial-read": {"id": 32, "args": 1},
        "%serial-avail": {"id": 33, "args": 1}
    }
}