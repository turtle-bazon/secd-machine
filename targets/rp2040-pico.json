{
    "name": "rp2040-pico",
    "chip": "rp2040",
    "board": "Raspberry Pi Pico",
    "description": "Raspberry Pi Pico with RP2040",
    "version": "0.1.0",
    
    "output": {
        "format": "uf2",
        "family": "rp2040"
    },
    
    "memory": {
        "heap_size": 4095,
        "stack_size": 16000,
        "symbols_size": 256,
        "flash_size": 2097152,
        "sram_size": 270336
    },
    
    "flash_layout": {
        "firmware_addr": 0,
        "firmware_size": 1048576,
        "bytecode_addr": 1048576,
        "bytecode_size": 524288
    },
    
    "features": [
        "has-gpio",
        "has-uart",
        "has-spi",
        "has-i2c",
        "has-adc",
        "has-pwm",
        "has-timer"
    ],
    
    "primitives": {
        "gpio-init": {"id": 15, "args": 2},
        "gpio-write": {"id": 16, "args": 2},
        "gpio-read": {"id": 17, "args": 1},
        "uart-init": {"id": 18, "args": 1},
        "uart-write": {"id": 19, "args": 1},
        "uart-read": {"id": 20, "args": 0},
        "sleep": {"id": 21, "args": 1},
        "millis": {"id": 22, "args": 0},
        "adc-read": {"id": 23, "args": 1},
        "pwm-write": {"id": 24, "args": 2}
    },
    
    "constraints": {
        "max_fixnum": 32767,
        "min_fixnum": -32768,
        "bignum_support": false,
        "max_string_length": 256,
        "max_list_depth": 64
    }
}
