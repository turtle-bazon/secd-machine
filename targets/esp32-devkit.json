{
    "name": "esp32-devkit",
    "chip": "esp32",
    "board": "ESP32 DevKit",
    "description": "Espressif ESP32 DevKit",
    "version": "0.1.0",
    
    "output": {
        "format": "uf2",
        "family": "esp32"
    },
    
    "memory": {
        "heap_size": 400000,
        "stack_size": 32000,
        "symbols_size": 512,
        "flash_size": 4194304,
        "sram_size": 532480
    },
    
    "flash_layout": {
        "firmware_addr": 0,
        "firmware_size": 1572864,
        "bytecode_addr": 1572864,
        "bytecode_size": 1048576
    },
    
    "features": [
        "has-gpio",
        "has-uart",
        "has-spi",
        "has-i2c",
        "has-adc",
        "has-pwm",
        "has-wifi",
        "has-ble",
        "has-timer"
    ],
    
    "primitives": {
        "gpio-init": {"id": 128, "args": 2},
        "gpio-write": {"id": 129, "args": 2},
        "gpio-read": {"id": 130, "args": 1},
        "uart-init": {"id": 131, "args": 1},
        "uart-write": {"id": 132, "args": 1},
        "uart-read": {"id": 133, "args": 0},
        "sleep": {"id": 134, "args": 1},
        "millis": {"id": 135, "args": 0},
        "adc-read": {"id": 136, "args": 1},
        "pwm-write": {"id": 137, "args": 2},
        "wifi-connect": {"id": 138, "args": 2},
        "wifi-disconnect": {"id": 139, "args": 0},
        "http-get": {"id": 140, "args": 1}
    },
    
    "constraints": {
        "max_fixnum": 2147483647,
        "min_fixnum": -2147483648,
        "bignum_support": true,
        "max_string_length": 1024,
        "max_list_depth": 128
    }
}
